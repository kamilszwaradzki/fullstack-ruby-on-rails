<h1 class="font-bold">Podgląd grupy</h1>
<%= link_to "Wróć", admin_groups_path,  class: "btn btn-primary w-25 mb-2" %>
<%= button_to "Wygeneruj zajęcia na następny miesiąc", admin_group_lesson_generation_path(@group), method: :post, class: "btn btn-success w-75" %>
<table>
    <tr>
        <th>Kurs</th>
        <th>Instruktor</th>
        <th>Dzień tygodnia</th>
        <th>Godzina</th>
        <th>Czas trwania</th>
        <th>Pojemność</th>
        <th>Akcje</th>
    </tr>
    <tr>
        <td><%= @group.course.name %></td>
        <td><%= @group.instructor.name %></td>
        <td><%= I18n.t("date.day_names")[@group.weekday] %></td>
        <td><%= @group.starts_at.strftime("%H:%M") %></td>
        <td><%= @group.duration %> min</td>
        <td><%= @group.capacity %></td>
        <td>
            <%= link_to 'Edytuj', edit_admin_group_path(@group), class: "btn btn-success w-25" %>
            <%= button_to 'Usuń', admin_group_path(@group), method: :delete, class: "btn btn-danger w-25 my-1", form_class: "inline" %>
        </td>
    </tr>
</table>
<h1 class="font-extrabold mt-10 text-green-600 mx-auto">Zajęcia</h1>
<hr/>
<% if @group.lessons.empty? %>
    Brak zaplanowanych zajęć.
<% else %>
<table>
    <tr>
        <th>Termin</th>
        <th>Odwołane</th>
        <th>Akcje</th>
    </tr>
    <% @group.lessons.order(:starts_at).each do |lesson| %>
    <tr>
        <td><%= l(lesson.starts_at, format: :short) %></td>
        <td><%= lesson.cancelled? ? 'tak' : 'nie' %></td>
        <td><% unless lesson.cancelled? %> <%= button_to "Odwołaj", admin_group_lesson_cancellation_path(@group, lesson), form: { data: { turbo_confirm: 'Chcesz odwołać lekcję?' } }, class: "btn btn-danger w-25 my-1" %> <% end %></td>
    </tr>
    <% end %>
</table>
<% end %>