<%= render "admin/nav" %>
<h1 class="font-bold">Panel Grup</h1>
<%= link_to 'Nowa grupa', new_admin_group_path, class: "btn btn-primary w-1/2 my-2" %>
<% if @groups.empty? %>
    Brak grup.
<% else %>
    <div class="overflow-x-auto">
        <table class="table-bordered table-auto">
        <tr>
            <th>Kurs</th>
            <th>Instruktor</th>
            <th>Dzień tygodnia</th>
            <th>Godzina</th>
            <th>Czas trwania</th>
            <th>Pojemność</th>
            <th>Akcje</th>
        </tr>
        <% @groups.each do |group| %>
        <tr>
            <td><%= group.course.name %></td>
            <td><%= group.instructor.name %></td>
            <td><%= I18n.t("date.day_names")[group.weekday] %></td>
            <td><%= group.starts_at.strftime("%H:%M") %></td>
            <td><%= group.duration %> min</td>
            <td><%= group.capacity %></td>
            <td>
                <div class="flex gap-2">
                    <%= link_to 'Pokaż', admin_group_path(group), class: "btn btn-primary" %>
                    <%= link_to 'Edytuj', edit_admin_group_path(group), class: "btn btn-success" %>
                    <%= button_to 'Usuń', admin_group_path(group), method: :delete, class: "btn btn-danger my-1", form_class: "inline" %>
                </div>
            </td>
        </tr>
        <% end %>
        </table>
    </div>
<% end %>