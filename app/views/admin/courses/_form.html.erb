<%= form_with model: [:admin, @course] do |form| %>
<% if @course.errors.any? %>
<ul>
    <% @course.errors.full_messages.each do |message| %>
    <li>
        <%= message %>
    </li>
    <% end %>
</ul>
<% end %>
<%= form.label :name, "Nazwa" %> 
<%= form.text_field :name, class: "block w-full rounded border-gray-300" %>
<%= form.label :description, "Opis" %> 
<%= form.text_area :description, class: "block w-full rounded border-gray-300 mb-3" %>
<%= form.label :level, "Poziom" %> 
<%= form.select :level, Course.levels.keys, class: "my-3" %>
<br/>
<%= form.submit class: "btn btn-success my-2" %>
<% end %>