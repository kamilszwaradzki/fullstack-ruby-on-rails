<%= render "admin/nav" %>
<h1 class="font-bold">Panel kursów</h1>
<%= link_to 'Nowy kurs', new_admin_course_path, class: "btn btn-primary w-1/2 my-2" %>
<% if @courses.empty? %>
    Brak kursów.
<% else %>
    <div class="overflow-x-auto">
        <table class="table-bordered table-auto">
        <tr>
            <th>Nazwa kursu</th>
            <th>Opis</th>
            <th>Poziom zaawansowania</th>
            <th>Akcje</th>
        </tr>
        <% @courses.each do |course| %>
        <tr>
            <td><%= course.name %></td>
            <td><%= course.description %></td>
            <td><%= course.level %></td>
            <td>
                <div class="flex gap-2">
                    <%= link_to 'Pokaż', admin_course_path(course), class: "btn btn-primary" %>
                    <%= link_to 'Edytuj', edit_admin_course_path(course), class: "btn btn-success" %>
                    <%= button_to 'Usuń', admin_course_path(course), method: :delete, class: "btn btn-danger my-1", form_class: "inline" %>
                </div>
            </td>
        </tr>
        <% end %>
        </table>
    </div>
<% end %>