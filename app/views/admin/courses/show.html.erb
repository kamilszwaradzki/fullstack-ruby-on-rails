<h1 class="font-bold text-2xl mb-2">Podgląd kursu</h1>
<%= link_to "Wróć", admin_courses_path,  class: "self-start btn btn-primary" %>
<div class="overflow-x-auto">
    <table class="table-bordered table-auto">
        <tr>
            <th>Nazwa kursu</th>
            <th>Opis</th>
            <th>Poziom zaawansowania</th>
            <th>Akcje</th>
        </tr>
        <tr>
            <td><%= @course.name %></td>
            <td><%= @course.description %></td>
            <td><%= @course.level %></td>
            <td>
                <div class="flex items-center gap-2">
                    <%= link_to 'Edytuj', edit_admin_course_path(@course), class: "btn btn-success" %>
                    <%= button_to 'Usuń', admin_course_path(@course), method: :delete, class: "btn btn-danger my-1", form_class: "inline" %>
                </div>
            </td>
        </tr>
    </table>
</div>