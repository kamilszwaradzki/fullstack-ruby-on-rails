<h1 class="font-bold">Podgląd kursu</h1>
<%= link_to "Wróć", admin_courses_path,  class: "btn btn-primary w-25" %>

<table>
    <tr>
        <th>Nazwa kursu</th>
        <th>Opis</th>
        <th>Poziom zaawansowania</th>
        <th>Akcje</th>
    </tr>
    <tr>
        <td><%= @course.name %></td>
        <td><%= @course.description %></td>
        <td><%= @course.level %></td>
        <td>
            <%= link_to 'Edytuj', edit_admin_course_path(@course), class: "btn btn-success w-25" %>
            <%= button_to 'Usuń', admin_course_path(@course), method: :delete, class: "btn btn-danger w-25 my-1", form_class: "inline" %>
        </td>
    </tr>
</table>