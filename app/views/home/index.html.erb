<main class="min-h-screen bg-gray-50">
  <section class="relative overflow-hidden bg-slate-900 text-white">
    <div class="max-w-6xl mx-auto px-6 py-24 md:py-32">
      <div class="max-w-3xl">
        <span class="inline-flex items-center rounded-full bg-blue-500/10 px-3 py-1 text-sm font-medium text-blue-300 ring-1 ring-blue-500/30">
          System zarządzania szkołą tańca
        </span>

        <h1 class="mt-6 text-5xl md:text-7xl font-bold tracking-tight">
          Grafik<span class="text-blue-400">.</span>
        </h1>

        <p class="mt-6 text-lg md:text-xl leading-relaxed text-slate-300">
          Jedno miejsce do zarządzania zajęciami, zapisami,
          listami rezerwowymi i obecnością uczestników.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <%= link_to "Zaloguj się", new_session_path,
              class: "rounded-lg bg-blue-600 px-6 py-3 font-semibold text-white hover:bg-blue-500 transition" %>
        </div>
      </div>
    </div>
  </section>

  <!-- Role -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="max-w-2xl mb-12">
      <h2 class="text-3xl font-bold text-gray-900">
        Jedna platforma, trzy role
      </h2>
      <p class="mt-3 text-gray-600">
        Każdy użytkownik otrzymuje dostęp do funkcji
        dopasowanych do swojej roli w szkole tańca.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <article class="flex flex-col rounded-xl border border-gray-200 bg-white p-7 shadow-sm">
        <div class="flex items-center justify-center size-12 rounded-lg bg-blue-100 text-blue-700">
          <span class="text-2xl">🧑‍🎓</span>
        </div>

        <h3 class="mt-5 text-xl font-bold text-gray-900">
          Uczestnik
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Zarządzaj swoimi zajęciami i zapisami.
        </p>

        <ul class="mt-6 space-y-3 text-sm text-gray-700">
          <li>✓ Przeglądanie dostępnych grup i zajęć</li>
          <li>✓ Zapisy na zajęcia i listy rezerwowe</li>
          <li>✓ Podgląd swoich karnetów</li>
        </ul>

        <div class="mt-auto pt-8">
          <%= button_to "Wejdź jako uczestnik", session_path,
              method: :post,
              params: {
                email_address: "student@example.com",
                password: "Student789!"
              },
              class: "w-full rounded-lg bg-blue-600 px-4 py-3 font-semibold text-white hover:bg-blue-500 transition" %>
        </div>
      </article>

      <article class="flex flex-col rounded-xl border border-gray-200 bg-white p-7 shadow-sm">
        <div class="flex items-center justify-center size-12 rounded-lg bg-emerald-100 text-emerald-700">
          <span class="text-2xl">🧑‍🏫</span>
        </div>

        <h3 class="mt-5 text-xl font-bold text-gray-900">
          Instruktor
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Organizuj zajęcia i kontroluj postępy grup.
        </p>

        <ul class="mt-6 space-y-3 text-sm text-gray-700">
          <li>✓ Podgląd przypisanych grup</li>
          <li>✓ Dostęp do nadchodzących lekcji</li>
          <li>✓ Prowadzenie list obecności</li>
        </ul>

        <div class="mt-auto pt-8">
          <%= button_to "Wejdź jako instruktor", session_path,
              method: :post,
              params: {
                email_address: "instructor@example.com",
                password: "Instructor456!"
              },
              class: "w-full rounded-lg bg-emerald-600 px-4 py-3 font-semibold text-white hover:bg-emerald-500 transition" %>
        </div>
      </article>

      <article class="flex flex-col rounded-xl border border-gray-200 bg-white p-7 shadow-sm">
        <div class="flex items-center justify-center size-12 rounded-lg bg-violet-100 text-violet-700">
          <span class="text-2xl">⚙️</span>
        </div>

        <h3 class="mt-5 text-xl font-bold text-gray-900">
          Administrator
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Zarządzaj działalnością całej szkoły.
        </p>

        <ul class="mt-6 space-y-3 text-sm text-gray-700">
          <li>✓ Zarządzanie uczestnikami i grupami</li>
          <li>✓ Kontrola zapisów i list rezerwowych</li>
          <li>✓ Monitorowanie karnetów i zajęć</li>
        </ul>

        <div class="mt-auto pt-8">
          <%= button_to "Wejdź jako administrator", session_path,
              method: :post,
              params: {
                email_address: "admin@example.com",
                password: "Admin123!"
              },
              class: "w-full rounded-lg bg-violet-600 px-4 py-3 font-semibold text-white hover:bg-violet-500 transition" %>
        </div>
      </article>

    </div>
  </section>

  <footer class="border-t border-gray-200 bg-white">
    <div class="max-w-6xl mx-auto px-6 py-8 text-center text-sm text-gray-500">
      Grafik — system zarządzania szkołą tańca
    </div>
  </footer>
</main>
