<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/head" %>
  </head>

  <body>
    <main class="container mx-auto mt-8 md:mt-28 px-5 flex flex-col">
      <% if authenticated? %>
        <%= render "auth/nav" %>
      <% end %>
      <div id="flash">
        <%= render "layouts/flash" %>
      </div>
      <%= yield %>
    </main>
  </body>
</html>
