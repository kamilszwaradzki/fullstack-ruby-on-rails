<% if @groups.empty? %>
Brak grup.
<% else %>
  <% @groups.group_by(&:weekday).each do |weekday, groups| %>
  <h1 class="my-2 font-extrabold"><%= I18n.t("date.day_names")[weekday] %></h1>
    <% groups.each do |group| %>
      <%= render "group_card", group: group %>
    <% end %>
  <% end %>
<% end %>