<h1 class="font-bold text-2xl mb-2">Podgląd grupy</h1>
<%= link_to "Wróć", instructor_groups_path,  class: "self-start btn btn-primary mb-2" %>
<div class="overflow-x-auto">
    <table class="table-bordered table-auto">
        <tr>
            <th>Kurs</th>
            <th>Instruktor</th>
            <th>Dzień tygodnia</th>
            <th>Godzina</th>
            <th>Czas trwania</th>
            <th>Pojemność</th>
        </tr>
        <tr>
            <td><%= @group.course.name %></td>
            <td><%= @group.instructor.name %></td>
            <td><%= I18n.t("date.day_names")[@group.weekday] %></td>
            <td><%= @group.starts_at.strftime("%H:%M") %></td>
            <td><%= @group.duration %> min</td>
            <td><%= @group.capacity %></td>
        </tr>
    </table>
</div>
<h1 class="font-bold text-lg mt-10 text-green-600 mx-auto">Zajęcia</h1>
<hr/>
<% if @group.lessons.empty? %>
    Brak zaplanowanych zajęć.
<% else %>
<div class="overflow-x-auto">
    <table class="table-bordered table-auto">
        <tr>
            <th>Termin</th>
            <th>Odwołane</th>
            <th>Akcje</th>
        </tr>
        <% @group.lessons.order(:starts_at).each do |lesson| %>
        <tr>
            <td><%= l(lesson.starts_at, format: :short) %></td>
            <td><%= lesson.cancelled? ? 'tak' : 'nie' %></td>
            <td>
            <% unless lesson.cancelled? %>
                <%= link_to "Obecność", instructor_group_lesson_path(@group, lesson), class: "btn btn-notice py-1 text-sm" %>
            <% end %>
            </td>
        </tr>
        <% end %>
    </table>
</div>
<% end %>